# Groq LLM API Configuration
GROQ_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (PostgreSQL 17)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qwipi_db

# SQLAlchemy Async Connection String
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password@localhost:5432/qwipi_db

# Redis In-Memory Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
SECRET_KEY=generate_a_random_64_character_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS & Network Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin Bootstrap (Optional: automatically promoted on server start)
FIRST_SUPERUSER_EMAIL=admin@qwipi.ai
